{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{styles.css,app.js,index.html,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
