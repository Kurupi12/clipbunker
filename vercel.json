{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{styles.css,app.js,index.html,fallback_preview.mp4,yt_source_*.mp4,data/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/exports/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
